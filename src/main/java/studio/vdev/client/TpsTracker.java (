package studio.vdev.client;

public class TpsTracker {
    private static long last = 0;
    private static double tps = 20.0;
    private static boolean has = false;

    // Servers send a time update every 20 ticks, so 20 ticks / elapsed seconds = TPS
    public static void onTimeUpdate() {
        long now = System.nanoTime();
        if (last != 0) {
            double elapsed = (now - last) / 1_000_000_000.0;
            if (elapsed > 0) {
                double sample = Math.min(20.0, 20.0 / elapsed);
                tps = has ? tps * 0.7 + sample * 0.3 : sample;
                has = true;
            }
        }
        last = now;
    }

    public static void reset() {
        last = 0;
        has = false;
        tps = 20.0;
    }

    public static String text() {
        return has ? String.format("%.1f", tps) : "--";
    }
}
